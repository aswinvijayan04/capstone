{
  "title": "FinSecure Pay - Transaction Validator",
  "uid": "finsecure-tv",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Available app pods (app metric from Kubernetes)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"default\", deployment=\"transaction-validator\"}" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP requests per second (application)",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"transaction-validator\"}[1m]))", "legendFormat": "{{uri}}" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "JVM heap memory used, MB (application)",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (jvm_memory_used_bytes{job=\"transaction-validator\", area=\"heap\"}) / 1024 / 1024", "legendFormat": "{{pod}}" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Node CPU usage % (infrastructure)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "{{instance}}" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Pod restarts (infrastructure)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"default\"})", "legendFormat": "{{pod}}" } ]
    }
  ]
}